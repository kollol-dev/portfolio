{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portfolio content",
  "description": "Everything shown on the site. Text starting with \"[PLACEHOLDER]\" shows as a dashed TBD box. Wrap words in *asterisks* in section titles for the brass italic accent.",
  "type": "object",
  "required": ["profile", "sections", "skills", "experience", "certifications", "projects", "education", "activities", "closingStatement"],
  "additionalProperties": false,
  "definitions": {
    "text": { "type": "string", "minLength": 1 },
    "optionalUrl": { "type": "string", "description": "Full URL, or \"\" if you don't have one yet." },
    "textList": { "type": "array", "items": { "type": "string" } },
    "section": {
      "type": "object",
      "required": ["navLabel", "eyebrow", "title"],
      "properties": {
        "navLabel": { "type": "string", "description": "Text in the top navigation." },
        "eyebrow": { "type": "string", "description": "Small uppercase label above the heading." },
        "title": { "type": "string", "description": "Heading. Wrap a word in *asterisks* for the brass italic accent." },
        "stageCaption": { "type": "string", "description": "Caption on the 3D stage while this section's object is shown." }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "profile": {
      "type": "object",
      "required": ["name", "firstName", "lastName", "title", "location", "availability", "headline", "summary", "email", "resumePath", "photo", "socials"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "firstName": { "$ref": "#/definitions/text", "description": "First line of the big hero name." },
        "lastName": { "$ref": "#/definitions/text", "description": "Second line of the hero name, in brass italic." },
        "title": { "$ref": "#/definitions/text", "description": "Job title, e.g. Senior Software Engineer." },
        "location": { "$ref": "#/definitions/text", "description": "\"City, Country\" — used on the ID card and in search data." },
        "availability": { "$ref": "#/definitions/text", "description": "Shown on the back of the ID card." },
        "headline": { "$ref": "#/definitions/text", "description": "One-line statement under your name." },
        "summary": { "$ref": "#/definitions/text", "description": "Short paragraph in the intro; also the page description for Google." },
        "email": { "type": "string", "format": "email" },
        "resumePath": { "type": "string", "description": "Path to the PDF inside /public, e.g. /resume.pdf." },
        "photo": { "type": "string", "description": "Portrait for the ID card inside /public, e.g. /images/portrait.webp (4:5 ratio works best)." },
        "socials": {
          "type": "array",
          "description": "Profile links. An email link is added automatically.",
          "items": {
            "type": "object",
            "required": ["kind", "label", "href"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["github", "linkedin", "email"] },
              "label": { "type": "string" },
              "href": { "type": "string" }
            }
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "keywords": { "$ref": "#/definitions/textList", "description": "Search keywords." } }
    },
    "sections": {
      "type": "object",
      "required": ["intro", "experience", "certifications", "projects", "education", "activities", "contact"],
      "additionalProperties": false,
      "properties": {
        "intro": {
          "type": "object",
          "required": ["navLabel"],
          "properties": { "navLabel": { "type": "string" }, "stageCaption": { "type": "string" } }
        },
        "experience": {
          "allOf": [{ "$ref": "#/definitions/section" }],
          "properties": { "toolkitTitle": { "type": "string", "description": "Heading above the skills list." } }
        },
        "certifications": { "$ref": "#/definitions/section" },
        "projects": { "$ref": "#/definitions/section" },
        "education": { "$ref": "#/definitions/section" },
        "activities": { "$ref": "#/definitions/section" },
        "contact": {
          "allOf": [{ "$ref": "#/definitions/section" }],
          "properties": { "intro": { "type": "string", "description": "Sentence under the contact heading." } }
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "Shown as the Toolkit list at the end of Experience.",
      "items": {
        "type": "object",
        "required": ["label", "items"],
        "additionalProperties": false,
        "properties": { "label": { "type": "string" }, "items": { "$ref": "#/definitions/textList" } }
      }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "description": "Newest first. The last entry's start year is used as \"Since …\".",
      "items": {
        "type": "object",
        "required": ["company", "role", "location", "start", "end", "highlights"],
        "additionalProperties": false,
        "properties": {
          "company": { "type": "string" },
          "role": { "type": "string" },
          "location": { "type": "string" },
          "start": { "type": "string", "description": "e.g. Feb 2023" },
          "end": { "type": "string", "description": "e.g. Mar 2024, or Present" },
          "highlights": { "$ref": "#/definitions/textList" },
          "stack": { "$ref": "#/definitions/textList" }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "issuer", "period"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "issuer": { "type": "string" },
          "period": { "type": "string" },
          "credentialId": { "type": "string" },
          "verifyUrl": { "$ref": "#/definitions/optionalUrl" },
          "featured": { "type": "boolean", "description": "Show this one on the 3D framed certificate." }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "context", "role", "summary", "architecture", "challenges"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "context": { "type": "string", "description": "e.g. Company · 2023 – present" },
          "role": { "type": "string" },
          "summary": { "type": "string" },
          "architecture": { "$ref": "#/definitions/textList" },
          "challenges": { "$ref": "#/definitions/textList" },
          "stack": { "$ref": "#/definitions/textList" },
          "github": { "$ref": "#/definitions/optionalUrl" },
          "live": { "$ref": "#/definitions/optionalUrl" },
          "confidential": { "type": "boolean", "description": "Private client work: shows a note instead of links." },
          "featured": { "type": "boolean", "description": "Show this project on the 3D laptop." },
          "screen": {
            "type": "object",
            "description": "What the 3D laptop screen shows (featured project only).",
            "additionalProperties": false,
            "properties": {
              "tagline": { "type": "string" },
              "pipeline": { "$ref": "#/definitions/textList", "description": "Up to 4 short box labels." }
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["institution", "degree", "location", "period"],
        "additionalProperties": false,
        "properties": {
          "institution": { "type": "string" },
          "degree": { "type": "string" },
          "location": { "type": "string" },
          "period": { "type": "string" },
          "achievements": { "$ref": "#/definitions/textList" },
          "cover": {
            "type": "object",
            "description": "Lettering on the 3D book (first entry only).",
            "additionalProperties": false,
            "properties": { "title": { "type": "string" }, "subtitle": { "type": "string" } }
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "title", "organisation", "period", "description"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["leadership", "volunteering", "award"] },
          "title": { "type": "string" },
          "organisation": { "type": "string" },
          "period": { "type": "string" },
          "description": { "type": "string" },
          "badge": { "type": "string", "description": "2–3 letters in the badge on the 3D phone (first leadership entry)." },
          "tags": { "$ref": "#/definitions/textList", "description": "Up to 2 words for the pill on the 3D phone." }
        }
      }
    },
    "closingStatement": { "type": "string", "description": "Quote at the end of Activities." }
  }
}
