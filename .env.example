# ---------------------------------------------------------------
# Environment variables for this site — template, safe to share.
# Copy to .env.local (your computer) or .env.production (live site)
# and fill in real values. See README → "Environment variables".
# ---------------------------------------------------------------

# Public address of the live site, no trailing slash.
# Used for canonical links, social preview images and the sitemap.
# NEXT_PUBLIC_ variables are baked into the site when it is BUILT,
# so changing this needs a rebuild.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Admin dashboard (/admin) — SECRET: set in Hostinger's env panel, never commit ---
# Generate all three with: npm run admin:setup
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Where dashboard edits are saved. Use a folder OUTSIDE the app so redeploys don't wipe it.
# CONTENT_DATA_DIR=/home/USER/portfolio-data
